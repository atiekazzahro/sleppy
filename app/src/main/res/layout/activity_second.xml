<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- Header -->
        <ImageView android:id="@+id/ivDetailHeader" android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:contentDescription="Ikon Ringkasan" android:src="@drawable/ic_moon" />

        <TextView android:id="@+id/tvDetailJudul" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="@string/title_ringkasan" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />

        <TextView android:id="@+id/tvNamaPengguna" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" />

        <!-- Card 1: Durasi Utama & Status -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_card_accent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="22dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_durasi" android:textColor="@color/accent_indigo_light" android:textSize="12sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvDurasi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 Jam 0 Menit" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvBadgeStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_rounded" android:text="Status Tidur" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Rincian Jadwal Jam -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card_rounded" android:orientation="vertical" android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_detail_waktu" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />

            <!-- Row Mulai Tidur -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Ikon Mulai Tidur" android:src="@drawable/ic_moon" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/label_mulai_tidur" android:textColor="@color/text_secondary" android:textSize="14sp" />

                <TextView android:id="@+id/tvJamTidur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/surface_card_stroke" />

            <!-- Row Bangun Tidur -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Ikon Bangun Tidur" android:src="@drawable/ic_sun" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/label_selesai_tidur" android:textColor="@color/text_secondary" android:textSize="14sp" />

                <TextView android:id="@+id/tvJamBangun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Card 3: Rekomendasi Kesehatan -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card_rounded" android:orientation="vertical" android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_saran" android:textColor="@color/accent_indigo_light" android:textSize="14sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvSaran" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_label" android:textSize="14sp" />
        </LinearLayout>

        <!-- Legacy ID for backward compatibility -->
        <TextView android:id="@+id/tvDetailInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

        <!-- Tombol Bagikan (Intent Implisit) -->
        <Button android:id="@+id/btnBagikan" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="@string/btn_bagikan" android:textColor="@color/text_primary" android:textSize="15sp" app:cornerRadius="12dp" app:icon="@drawable/ic_share" app:iconTint="@color/text_primary" app:strokeColor="@color/surface_card_stroke" />

        <!-- Tombol Kembali (Intent Eksplisit Navigation Back) -->
        <Button android:id="@+id/btnKembali" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:layout_marginBottom="16dp" android:text="@string/btn_kembali" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/primary_indigo" app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
